# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/AI_Interview?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_production_secret_key
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# AI Engine (Google Gemini or OpenRouter)
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
UPI_ID=your_upi_id@bank
UPI_MERCHANT_NAME=YourName

